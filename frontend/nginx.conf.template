# Rendered at container start by the nginx image (envsubst): ${PORT} and ${BACKEND_URL}
# come from the environment. Nginx's own $variables are left untouched.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Same-origin API: the HttpOnly auth cookie works without CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # The backend's own host name: required when it sits behind a routing edge (e.g. Railway).
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Server-Sent Events (live seat updates) must not be buffered.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routing.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
