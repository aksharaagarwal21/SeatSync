# Copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_DB=seatsync
DATABASE_URL=jdbc:postgresql://postgres:5432/seatsync
DATABASE_USERNAME=seatsync
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=30

# JWT: at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION=24h
# Set to true when serving over HTTPS so the auth cookie is Secure.
JWT_COOKIE_SECURE=false

# Booking concurrency: OPTIMISTIC (default) or PESSIMISTIC
BOOKING_LOCKING_STRATEGY=OPTIMISTIC

# dev = seed demo data on first start; default = empty database
SPRING_PROFILES_ACTIVE=dev

# Host ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
